{
  "manifest_version": 3,
  "name": "Bootlegger Draft Overlay",
  "version": "1.1.0",
  "description": "The back room, pinned inside the Sleeper draft room — The Call, survival odds, and shelf needs from your Bootlegger board.",
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "https://sleeper.com/draft/*",
        "https://www.sleeper.com/draft/*",
        "https://app.sleeper.com/draft/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "host_permissions": ["http://192.168.1.160:8484/*"],
  "permissions": ["clipboardWrite"]
}
