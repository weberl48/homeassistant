# Bootlegger configuration. Copy to .env (compose reads it) or export in the shell.

# demo = synthetic league + simulated draft, no network needed. live = your league.
BOOTLEGGER_MODE=demo

# --- live mode ---
SLEEPER_LEAGUE_ID=
SLEEPER_USER_ID=
SLEEPER_DRAFT_ID=            # optional; discovered from the league when empty
BOOTLEGGER_MY_ROSTER_ID=7
BOOTLEGGER_SEASON=2026

# --- actuation (design doc §5) ---
BOOTLEGGER_APPROVE_REQUIRED=1   # 0 = auto_execute (earn 3 clean weeks first)
HANDS_DRY_RUN=1                 # 0 = drive the real Sleeper web UI (needs storageState)

# --- reliability ---
HEALTHCHECKS_URL=               # https://hc-ping.com/<uuid>; empty disables
EXPO_PUSH_TOKENS=               # comma-separated ExponentPushToken[...] (or register via the app)

# --- demo pacing ---
DEMO_PICK_SECONDS=5
DEMO_MY_CLOCK_SECONDS=16
